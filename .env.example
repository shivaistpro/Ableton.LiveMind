# Copia questo file in .env (stessa cartella) e adatta i valori al tuo PC.
# .env non va mai in Git. Le variabili gia' impostate nel sistema hanno la precedenza.
# Lascia commentato quello che va bene col default.

# Output di sessione: render, catture audio, screenshot, JSON (default: <repo>/out)
# LIVEMIND_OUT=D:\LIVEMIND-out

# Cartelle dove cercare i set .als, separate da ; (default: Documents\Ableton;Documents;Music)
# LIVEMIND_PROJECT_DIRS=D:\Progetti Ableton;C:\Users\<tuo-utente>\Music

# KICK 3: cartella User Presets (default: install standard Windows)
# LIVEMIND_KICK3_PRESETS=C:\ProgramData\Sonic Academy\Kick 3\User\Presets

# Ozone 11 VST3 per il mastering offline (default: install standard Windows)
# LIVEMIND_OZONE_VST3=C:\Program Files\Common Files\VST3\iZotope\Ozone 11.vst3

# Mix da masterizzare con tools/ozone/* (obbligatoria solo per quegli script)
# LIVEMIND_MASTER_SRC=C:\percorso\del\mio_mix.wav

# Nome del clipper sul Main usato dagli script di livellamento master
# LIVEMIND_CLIPPER=StandardCLIP

# User Library di Ableton, se non e' in Documents\Ableton (es. Documents su OneDrive)
# LIVEMIND_USER_LIBRARY=C:\Users\<tuo-utente>\OneDrive\Documents\Ableton\User Library
